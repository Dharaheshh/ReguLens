# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# LLM Primary (Groq)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE_DEFAULT=0.2

# LLM Fallback (Gemini)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=your_gemini_api_key_here
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# Embeddings (Local)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# App config
DEMO_BEARER_TOKEN=your_demo_token_here
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
